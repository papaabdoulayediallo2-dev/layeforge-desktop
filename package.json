{
  "name": "layeforge",
  "version": "1.0.0",
  "description": "Transformez vos fichiers HTML/CSS/JS en application desktop Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "setup-env": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-node.ps1",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.layeforge.app",
    "productName": "LayeForge",
    "icon": "src/assets/icon.png",
    "directories": {
      "output": "dist-generator"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "bin/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "LayeForge"
    }
  },
  "keywords": [
    "electron",
    "builder",
    "packager",
    "html",
    "desktop"
  ],
  "author": "LayeForge",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "archiver": "^6.0.1",
    "fs-extra": "^11.2.0",
    "javascript-obfuscator": "^5.4.1"
  }
}
