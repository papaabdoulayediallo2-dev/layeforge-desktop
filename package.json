{
  "name": "layeforge",
  "version": "1.0.0",
  "description": "Transformez vos fichiers HTML/CSS/JS en application desktop Electron avec LayeForge",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64"
  },
  "keywords": [
    "electron",
    "builder",
    "packager",
    "html",
    "desktop",
    "layeforge"
  ],
  "author": "Papa Abdoulaye Diallo (Laye)",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "javascript-obfuscator": "^5.4.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "archiver": "^6.0.1",
    "fs-extra": "^11.2.0"
  },
  "build": {
    "appId": "com.layeforge.generator",
    "productName": "LayeForge",
    "win": {
      "target": "portable",
      "icon": "assets/icon.png"
    },
    "directories": {
      "output": "dist-generator"
    }
  }
}
